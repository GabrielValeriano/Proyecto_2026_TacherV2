{
  "expo": {
    "name": "TacherV2",
    "slug": "TacherV2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LogoTacherV2.jpeg",
    "scheme": "com.tacherv2.app",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tacherv2.app"
    },
    "android": {
      "package": "com.tacherv2.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/LogoTacherV2.jpeg",
        "backgroundColor": "#1b4332"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1b4332",
          "imageWidth": 120
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#268257"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ed46367-d0e2-4f5b-916a-b975a9c3dc88"
      }
    }
  }
}
